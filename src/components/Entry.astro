---
import { Image, Picture } from 'astro:assets';
import { render } from 'astro:content';
import Platforms from './Platforms.astro';
import { site, fill } from '../site.config';
import { projectIndex, type Project } from '../lib/projects';
import Rule from './Rule.astro';

interface Props {
  project: Project;
  position: number;
  total: number;
}

const { project, position, total } = Astro.props;
const href = `/work/${project.id}/`;
const { entry } = site.sections;
const data = project.data;
const folio = projectIndex(position);

/** A project may set its own accent; otherwise the plate wash uses the site spot. */
const spill = data.accent ?? site.theme.accent;

/** "Live" while a project is still being worked on or shipped; quiet if retired. */
const state = data.status === 'Prototype' ? 'quiet' : 'live';

const { Content } = await render(project);
---

<Rule index={position} />

<article class="section shell grid entry" id={project.id} style={`--spill:${spill}`}>
  <div class="entry__head">
    <p class="visually-hidden">
      {fill(entry.ordinal, { n: position + 1, total })}
    </p>

    {/*
      The numeral is set as CSS content, not as text. It is deliberately at
      1.16:1 against the page so it reads as blind embossing pressed into paper
      rather than as type, which is a WCAG "pure decoration" case. The real
      ordinal is the visually-hidden "Entry n of m" above.
    */}
    <p class="entry__folio display display--xl" data-folio={folio} aria-hidden="true"></p>

    <div class="entry__titleline">
      {
        data.icon && (
          <Image
            class="appmark appmark--lg"
            src={data.icon}
            alt=""
            width={96}
            height={96}
            loading={position === 0 ? 'eager' : 'lazy'}
          />
        )
      }
      <h3 class="entry__title display">
        <a class="entry__link" href={href}>{data.title}</a>
      </h3>
    </div>

    <p class="lede entry__premise">{data.tagline}</p>

    <div class="prose"><Content /></div>

    <dl class="entry__meta">
      <div class="entry__metarow">
        <dt class="label">{entry.meta.role}</dt>
        <dd class="value">{entry.roleValue}</dd>
      </div>
      {
        data.platforms.length > 0 && (
          <div class="entry__metarow">
            <dt class="label">{entry.meta.platforms}</dt>
            <dd class="value"><Platforms platforms={data.platforms} /></dd>
          </div>
        )
      }
      <div class="entry__metarow">
        <dt class="label">{entry.meta.status}</dt>
        <dd class="value entry__status">
          {/* Never colour alone: the square always sits beside its word. */}
          <span class="entry__mark" data-state={state} aria-hidden="true"></span>
          {data.status}
        </dd>
      </div>
    </dl>

    <p class="entry__links">
      <a class="link" href={href}>
        {`↗ ${data.title}, in full`}
      </a>
    </p>

    {
      data.links.length > 0 && (
        <p class="entry__links">
          {data.links.map((link) => (
            <a
              class="link"
              href={link.href}
              target="_blank"
              rel="noopener me"
            >
              {`↗ ${link.label}`}
              <span class="visually-hidden">{` (${data.title})`}</span>
            </a>
          ))}
        </p>
      )
    }
  </div>

  {/*
    The plate. A mat mounted on a stage, with a recessed well inside it.

    The stage owns the perspective; the mat is what actually rotates, and the
    well and the label sit forward of it on the Z axis so the tilt produces real
    parallax between the frame and its contents rather than a flat skew.

    The unlit state is a scrim rather than a filter, deliberately: a `filter` on
    an ancestor flattens `transform-style: preserve-3d`, which would collapse
    the whole effect.
  */}
  <div class="plate-stage" data-plate>
    <div class="plate">
      <div class="plate__depth">
        {
          data.cover && data.coverAlt ? (
            <div class="plate__well" style="padding:0">
              <Picture
                class="plate__img"
                src={data.cover}
                alt={data.coverAlt}
                formats={['avif', 'webp']}
                widths={[480, 960]}
                sizes="(min-width: 1024px) 33vw, 100vw"
                loading={position === 0 ? 'eager' : 'lazy'}
                decoding={position === 0 ? 'auto' : 'async'}
              />
            </div>
          ) : (
            <div class="plate__well">
              <span class="label plate__label">In use</span>
              <ul class="plate__list">
                {data.highlights.map((highlight) => (
                  <li class="plate__item">{highlight}</li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>
    <p class="plate__caption">
      {`Plate ${folio} — ${data.category}`}
    </p>
  </div>
</article>
