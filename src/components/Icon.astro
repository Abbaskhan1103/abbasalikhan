---
/**
 * The site's whole icon set, inline.
 *
 * Inline SVG rather than an icon font or a sprite sheet: no extra request, no
 * flash of missing glyph, and each one inherits `currentColor` and the local
 * font size so it sits in a line of text like a letter does.
 *
 * House rules, so a new icon never looks bolted on:
 *   24x24 viewBox, geometry on whole or half pixels.
 *   Line pictograms: 1.6 stroke, round caps and joins, no fill.
 *   Brand marks: solid fill, no stroke, silhouette only.
 *   Never more than one of the two in a single icon.
 */
export type IconName =
  | 'apple'
  | 'android'
  | 'windows'
  | 'web'
  | 'build'
  | 'design'
  | 'ai'
  | 'automation'
  | 'domain'
  | 'mail'
  | 'linkedin'
  | 'arrow-up-right'
  | 'arrow-down';

interface Props {
  name: IconName;
  /** Decorative by default. Give a label only when the icon is the sole content. */
  label?: string;
  class?: string;
}

const { name, label, class: className } = Astro.props;
const solid =
  name === 'apple' || name === 'android' || name === 'windows' || name === 'linkedin';
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  width="1em"
  height="1em"
  fill={solid ? 'currentColor' : 'none'}
  stroke={solid ? 'none' : 'currentColor'}
  stroke-width={solid ? undefined : 1.6}
  stroke-linecap={solid ? undefined : 'round'}
  stroke-linejoin={solid ? undefined : 'round'}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {
    name === 'apple' && (
      <path d="M16.9 12.7c0-2.1 1.7-3.1 1.8-3.2-1-1.4-2.5-1.6-3-1.7-1.3-.1-2.5.8-3.2.8-.7 0-1.7-.7-2.7-.7-1.4 0-2.7.8-3.4 2.1-1.5 2.5-.4 6.3 1 8.3.7 1 1.5 2.1 2.6 2.1 1 0 1.4-.7 2.7-.7s1.6.7 2.7.7 1.8-1 2.5-2c.8-1.2 1.1-2.3 1.1-2.4 0 0-2.2-.8-2.1-3.3zM14.8 6.1c.6-.7 1-1.7.9-2.6-.8 0-1.8.5-2.4 1.2-.5.6-1 1.6-.9 2.5.9.1 1.8-.4 2.4-1.1z" />
    )
  }

  {
    name === 'android' && (
      <>
        <path d="M6.8 9.4h10.4c.3 0 .6.3.6.6v6.6c0 .8-.7 1.5-1.5 1.5H7.7c-.8 0-1.5-.7-1.5-1.5V10c0-.3.3-.6.6-.6z" />
        <path d="M4.2 10.2c.6 0 1.1.5 1.1 1.1v3.8a1.1 1.1 0 0 1-2.2 0v-3.8c0-.6.5-1.1 1.1-1.1zM19.8 10.2c.6 0 1.1.5 1.1 1.1v3.8a1.1 1.1 0 0 1-2.2 0v-3.8c0-.6.5-1.1 1.1-1.1zM9.4 18.8c.5 0 .9.4.9.9v1.4a1.1 1.1 0 0 1-2.2 0v-1.4c0-.5.4-.9.9-.9zM14.6 18.8c.5 0 .9.4.9.9v1.4a1.1 1.1 0 0 1-2.2 0v-1.4c0-.5.4-.9.9-.9z" />
        <path d="M8.4 3.2 7.6 4.7a5.9 5.9 0 0 1 8.8 0l-.8-1.5a.4.4 0 1 0-.7.4l.7 1.3a5.4 5.4 0 0 0-7.2 0l.7-1.3a.4.4 0 1 0-.7-.4z" />
        <circle cx="9.6" cy="7.3" r=".7" fill="var(--surface-raised, #171613)" />
        <circle cx="14.4" cy="7.3" r=".7" fill="var(--surface-raised, #171613)" />
      </>
    )
  }

  {
    name === 'windows' && (
      <path d="M3 5.6 10.4 4.6V11.3H3zM11.5 4.4 21 3v8.3H11.5zM3 12.4h7.4v6.7L3 18.1zM11.5 12.4H21V21l-9.5-1.3z" />
    )
  }

  {
    name === 'web' && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="M3.5 12h17M12 3.5c2.2 2.3 3.3 5.3 3.3 8.5s-1.1 6.2-3.3 8.5c-2.2-2.3-3.3-5.3-3.3-8.5S9.8 5.8 12 3.5z" />
      </>
    )
  }

  {/* Building: angle brackets. */}
  {name === 'build' && <path d="M8.5 7.5 3.5 12l5 4.5M15.5 7.5 20.5 12l-5 4.5M13.5 4.5l-3 15" />}

  {/* Design: a pen nib on a baseline. */}
  {
    name === 'design' && (
      <>
        <path d="M4 20.5 7.5 19l11-11a2.5 2.5 0 0 0-3.5-3.5l-11 11z" />
        <path d="M13.5 6.5 17.5 10.5" />
      </>
    )
  }

  {/* AI: a node reaching out to three others. */}
  {
    name === 'ai' && (
      <>
        <circle cx="12" cy="12" r="2.6" />
        <circle cx="12" cy="4.2" r="1.7" />
        <circle cx="19" cy="16" r="1.7" />
        <circle cx="5" cy="16" r="1.7" />
        <path d="M12 9.4V5.9M13.9 13.5l3.6 2M10.1 13.5l-3.6 2" />
      </>
    )
  }

  {/* Automation: a loop that returns to itself. */}
  {
    name === 'automation' && (
      <>
        <path d="M20 12a8 8 0 0 1-13.7 5.6M4 12a8 8 0 0 1 13.7-5.6" />
        <path d="M17.4 3.2v3.6h-3.6M6.6 20.8v-3.6h3.6" />
      </>
    )
  }

  {/* Domains: stacked plates. */}
  {
    name === 'domain' && (
      <>
        <path d="M12 3.2 21 7.6 12 12 3 7.6z" />
        <path d="M3 12.2 12 16.6l9-4.4M3 16.6 12 21l9-4.4" />
      </>
    )
  }

  {
    name === 'mail' && (
      <>
        <rect x="2.8" y="5" width="18.4" height="14" rx="0" />
        <path d="m3.4 6 8.6 6.6L20.6 6" />
      </>
    )
  }

  {
    name === 'linkedin' && (
      <path d="M20.4 2H3.6C2.7 2 2 2.7 2 3.6v16.8c0 .9.7 1.6 1.6 1.6h16.8c.9 0 1.6-.7 1.6-1.6V3.6c0-.9-.7-1.6-1.6-1.6zM8 19H5.1V9.5H8V19zM6.5 8.2a1.7 1.7 0 1 1 0-3.4 1.7 1.7 0 0 1 0 3.4zM19 19h-2.9v-4.6c0-1.1 0-2.5-1.5-2.5s-1.8 1.2-1.8 2.4V19H9.9V9.5h2.8v1.3h.1c.4-.7 1.3-1.5 2.8-1.5 3 0 3.5 2 3.5 4.5V19z" />
    )
  }

  {name === 'arrow-up-right' && <path d="M7 17 17 7M8.5 7H17v8.5" />}
  {name === 'arrow-down' && <path d="M12 4.5v15M5.5 13 12 19.5 18.5 13" />}
</svg>
