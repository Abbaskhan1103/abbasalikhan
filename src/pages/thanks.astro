---
import Base from '../layouts/Base.astro';
import RunningHead from '../components/RunningHead.astro';
import { site } from '../site.config';
import { buildPlainGraph } from '../lib/schema';

/**
 * Where a submission lands when JavaScript is unavailable. With script running,
 * the form reports back in place and nobody ever gets here.
 */
const title = `Thanks | ${site.identity.name}`;
const c = site.crm.copy;

const graph = buildPlainGraph({
  modified: new Date().toISOString(),
  path: '/thanks/',
  name: 'Thanks',
});
---

<Base graph={graph} title={title} description="Subscription confirmed." noindex>
  <RunningHead />
  <main id="main" class="shell centered-page">
    <p class="label">{c.label}</p>
    <h1 class="display display--xl centered-page__title">
      {c.success}
    </h1>
    <p class="lede">{c.note}</p>
    <p><a class="link" href="/">↓ Back to the index</a></p>
  </main>
</Base>
